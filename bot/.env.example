# ============================================================================
# Athena Telegram Bot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================================

# -- Required ------------------------------------------------------------------

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID (send /chatid to the bot after first run)
ALLOWED_CHAT_ID=

# Path to the Athena repo root (where CLAUDE.md lives)
# Defaults to the bot's parent directory if not set
ATHENA_DIR=

# Colon-separated absolute paths the filesystem MCP can read/write.
# Set via `./setup.sh` if you opted into filesystem access.
# Leave blank to disable. Example: /Users/you/Desktop:/Users/you/Documents
ATHENA_FS_ALLOWED=

# Set to "true" if you opted into computer-use MCP during setup.
# Server grants full mouse/keyboard/screen control on macOS.
# Requires Accessibility + Screen Recording permissions. High-risk — read SETUP.md.
ATHENA_COMPUTER_USE=false

# -- Identity ------------------------------------------------------------------

# Your name (used in conversation context)
USER_NAME=

# Assistant name (default: Athena)
ASSISTANT_NAME=Athena

# -- Voice: Speech-to-Text (optional) -----------------------------------------
# Transcribes voice notes you send. Pick one provider.

# Groq (free tier, recommended): https://console.groq.com
GROQ_API_KEY=

# OpenAI (paid per minute): https://platform.openai.com
OPENAI_API_KEY=

# -- Voice: Text-to-Speech (optional) -----------------------------------------
# Bot replies with audio. Requires ElevenLabs account.
# https://elevenlabs.io

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# -- Video Analysis (optional) ------------------------------------------------
# Analyze videos forwarded to the bot. Uses Google Gemini.
# https://aistudio.google.com

GOOGLE_API_KEY=

# -- WhatsApp Bridge (optional) ------------------------------------------------
# Read and reply to WhatsApp from Telegram. Experimental.

WHATSAPP_ENABLED=false

# -- Multi-user (optional) ----------------------------------------------------
# Comma-separated additional Telegram chat IDs allowed to use the bot.
# Each gets isolated sessions and memory.

ADDITIONAL_CHAT_IDS=
